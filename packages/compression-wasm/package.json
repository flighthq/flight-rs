{
  "name": "@flighthq/compression-wasm",
  "private": true,
  "version": "0.3.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight-rs.git",
    "directory": "packages/compression-wasm"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "wasm": "npm run wasm --prefix ../.. -- --package @flighthq/compression-wasm",
    "build": "npm run wasm && npm run build:package",
    "build:package": "tsc -b && tsx ./scripts/copy-wasm-glue.ts",
    "clean": "tsc -b --clean",
    "test": "vitest run --config vitest.config.ts",
    "test:upstream": "vitest run --config vitest.config.upstream.ts",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "prepack": "npm run clean && npm run clean:dist && npm run build",
    "clean:dist": "tsx ../../scripts/clean-package-dist.ts"
  },
  "dependencies": {
    "@flighthq/compression": "^0.5.0",
    "@flighthq/types": "^0.5.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "description": "Unpublished Rust/wasm DEFLATE decoder for the Flight compression registry",
  "sideEffects": false,
  "flightWasmSubstitute": {
    "authoritativePackage": "@flighthq/compression",
    "crate": "flighthq-compression-wasm",
    "facadeCrate": "flighthq-compression-wasm",
    "kind": "rust-wasm",
    "rustBacked": true,
    "supportLevel": "experimental"
  }
}
