// Typechecks the facade against the REAL pinned upstream sources instead of the
// local `src/upstream-contract.d.ts` shim. The shim exists so `tsc -b` can build
// this package standalone in a filtered checkout; it is a hand-written subset and
// nothing else proves it still matches upstream. This configuration closes that
// gap: if the shim drifts from `upstream/packages/*`, the facade stops compiling
// here even though the standalone build still succeeds.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "sourceMap": false,
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      "@flighthq/*/contract": ["upstream/packages/*/src/contract.ts"],
      "@flighthq/*": ["upstream/packages/*/src/index.ts"]
    },
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"]
  },
  // `upstream-webgpu.d.ts` supplies the `GPU*` names upstream's `Wgpu*.ts` modules reference. They
  // are declared locally rather than pulled from `@webgpu/types` so this check still runs in a
  // checkout with no registry access — see the file for why that matters.
  "include": ["src", "upstream-webgpu.d.ts"],
  "exclude": ["src/upstream-contract.d.ts"]
}
