{
  "name": "flight-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run generate:check && npm run typecheck && npm run typecheck:upstream && npm run lint && npm run format:check && npm run test",
    "ci": "npm run check && cargo test --workspace && npm run test:host-winit",
    "clean": "node -e \"for (const path of ['dist', 'build', 'coverage']) require('fs').rmSync(path, { force: true, recursive: true })\"",
    "edge:version": "tsx scripts/edge-version.ts",
    "flight:version": "tsx scripts/flight-version.ts",
    "fix": "npm run lint:fix && npm run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "tsx tools/generator/src/cli.ts",
    "generate:check": "tsx tools/generator/src/cli.ts --check",
    "inventory": "tsx tools/generator/src/cli.ts --inventory --json",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "release": "tsx scripts/publish-packages.ts",
    "test": "vitest run && vitest run --config packages/surface-rs/vitest.config.ts",
    "test:host-winit": "cargo test --manifest-path crates/flighthq-host-winit/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:upstream": "tsc -p packages/surface-rs/tsconfig.upstream.json",
    "upstream:latest": "tsx scripts/upstream-latest.ts",
    "version:packages": "tsx scripts/version-packages.ts",
    "wasm": "tsx tools/generator/src/build-wasm.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@vitest/coverage-v8": "4.1.10",
    "@webgpu/types": "0.1.72",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
