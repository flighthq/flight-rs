// Typechecks the consumer against the INSTALLED package's emitted declarations.
//
// This is the mechanized form of the check that caught a real defect: the facade's `.d.ts` imported
// `BitmapConvolutionOptions` from `@flighthq/bitmap`, which does not export it, so every consumer
// who typechecked our declarations got TS2305 while every in-repo suite stayed green.
//
// `skipLibCheck` is deliberately FALSE — with it on, the emitted `.d.ts` is never read and the bug is
// invisible. The webgpu shim is pulled in for the same reason it exists elsewhere: `@flighthq/types`
// references `GPU*` globals, and without declarations for them the run drowns in errors from files
// the consumer never touches.
{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts", "../../packages/bitmap-wasm/upstream-webgpu.d.ts"]
}
